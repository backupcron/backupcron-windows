<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BackupCron</AssemblyName>
    <ApplicationIcon>../../resources/AppIcon.ico</ApplicationIcon>
    <StartupObject>BackupCron.Windows.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BackupCron.Core/BackupCron.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/AppIcon.ico" Link="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
